# Serves the web UI from /srv/foidfinder/webui. Tagging runs in the visitor's browser (WebGPU), which downloads the
# model from Hugging Face, so the site has no API and needs no GPU.
foidfinder.net {
	encode zstd gzip

	header {
		defer
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=63072000"
	}

	root * /srv/foidfinder/webui
	header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self' https://huggingface.co https://*.hf.co; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header / Cache-Control no-cache
	try_files {path} {path}.html # /privacy serves privacy.html
	file_server
}

www.foidfinder.net {
	redir https://foidfinder.net{uri} permanent
}
