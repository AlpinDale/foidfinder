{
  "manifest_version": 3,
  "name": "foidfinder",
  "version": "0.2.0",
  "description": "Right-click an anime image to see its character, series and artist. The model runs on your GPU.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
