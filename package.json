{
  "name": "foidfinder",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@foidfinder/web",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "npm run build --workspace=@foidfinder/web",
    "build:extension": "npm run build --workspace=@foidfinder/extension",
    "typecheck": "tsc -p packages/engine/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/extension/tsconfig.json",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
